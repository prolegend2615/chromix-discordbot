DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_application_client_id
# Leave empty to register global commands. Set this for fast development registration.
DISCORD_GUILD_ID=
# Discord user ID allowed to grant/remove VIP with c.givevip and c.remove-vip.
VIP_ADMIN_ID=your_discord_user_id
GEMINI_API_KEY=your_google_ai_studio_api_key
# Optional selectable provider; also used as a fallback if configured.
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional selectable provider and automatic fallback.
XKIRO_API_KEY=
# Optional automatic chat fallbacks; these do not appear in /settings.
APINEX_API_KEY=
VYCEAI_API_KEY=
# Flux TTS voice ID used through OpenRouter.
OPENROUTER_TTS_VOICE=flux-alexis-en
# Required for Pollinations image generation. Keep this key secret.
POLLINATIONS_API_KEY=your_pollinations_api_key
# Optional web search providers. Configure both to enable AI-selected fallback.
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
